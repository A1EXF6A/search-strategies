---
import Base from "../layouts/Base.astro";
---

<Base title="Mantenimiento preventivo inteligente" activeTab="operacion">
  <style>
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px 40px;
    }

    .scene-panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      margin-top: 0;
    }

    .rig {
      display: flex;
      align-items: flex-start;
      gap: 18px;
    }

    .machine-col {
      flex: 1 1 auto;
      min-width: 0;
    }

    .machine-img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: radial-gradient(ellipse at 50% 30%, #2b2b2b 0%, #1c1c1c 75%);
    }

    .panel-col {
      flex: 0 0 296px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .input-card {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .card-head {
      display: flex;
      align-items: flex-start;
      gap: 9px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--accent);
      border: 1px solid var(--border);
      color: var(--on-accent);
      font-family: 'Geist Mono', monospace;
      font-weight: 500;
    }

    .card-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .card-head label {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--text);
    }

    .card-head label small {
      display: block;
      font-size: 0.72rem;
      font-weight: 400;
      color: var(--muted);
    }

    .card-body {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card-body input {
      flex: 1;
      min-width: 0;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 8px;
      color: var(--text);
      font-family: 'Geist Mono', monospace;
      font-size: 0.9rem;
    }

    .card-body input:focus {
      outline: 2px solid var(--accent-ink);
      border-color: transparent;
    }

    .unit {
      flex: none;
      font-size: 0.68rem;
      background: var(--accent);
      color: var(--on-accent);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 1px 5px;
    }

    .range {
      font-size: 0.7rem;
      color: var(--muted);
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 14px;
    }

    button.primary {
      background: var(--accent);
      border: none;
      border-radius: 8px;
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 500;
      color: var(--on-accent);
      cursor: pointer;
    }

    button.primary:hover { opacity: 0.92; }
    button.primary:disabled { opacity: 0.6; cursor: default; }

    .units-note {
      margin-top: 12px;
      font-size: 0.78rem;
      color: var(--muted);
      display: flex;
      flex-direction: column;
      gap: 6px 16px;
    }

    .units-note code {
      font-family: 'Geist Mono', monospace;
      color: var(--accent-ink);
    }

    .loading {
      display: none;
      color: var(--muted);
      text-align: center;
      padding: 14px 0;
    }

    .error {
      display: none;
      background: #3a201b;
      border: 1px solid var(--red);
      color: #ffb4a0;
      border-radius: 6px;
      padding: 12px;
      margin-top: 14px;
      font-size: 0.92rem;
    }

    .result {
      display: none;
      margin-top: 16px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
    }

    .result h2 { margin: 0 0 14px; font-size: 1.05rem; font-weight: 500; }

    .risk-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }

    .risk-score {
      font-size: 2.6rem;
      font-weight: 500;
      font-family: 'Geist Mono', monospace;
    }

    .risk-score small { font-size: 1.2rem; color: var(--muted); }

    .risk-level {
      font-size: 1.2rem;
      font-weight: 500;
      letter-spacing: 0.5px;
    }

    .bar {
      height: 14px;
      border-radius: 7px;
      background: #2b2b2b;
      border: 1px solid var(--border);
      overflow: hidden;
      margin: 12px 0 16px;
    }

    .bar-fill {
      height: 100%;
      width: 0%;
      border-radius: 6px;
      transition: width 0.4s ease;
    }

    .action {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 12px;
      margin-top: 4px;
    }

    .action strong { display: block; font-weight: 500; }
    .action span { color: var(--muted); font-size: 0.85rem; }

    .factors { margin-top: 16px; }
    .factors ul { margin: 8px 0 0; padding-left: 20px; }
    .factors li { margin: 4px 0; }

    .toggle {
      margin-top: 14px;
      display: inline-block;
      background: none;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--muted);
      padding: 8px 12px;
      font-size: 0.9rem;
      cursor: pointer;
      text-decoration: none;
    }

    a.toggle:hover {
      color: var(--accent-ink);
      border-color: var(--accent-ink);
    }

    @media (max-width: 920px) {
      .rig { flex-direction: column; }
      .panel-col { flex-basis: auto; width: 100%; }
    }
  </style>

  <main>
    <section class="scene-panel" aria-label="Máquina de referencia y condiciones">
      <div class="rig">
        <div class="machine-col">
          <img
            class="machine-img"
            src="/machine.png?v=6"
            alt="Esquema 2D de un torno con sensores numerados"
            width="1400"
            height="900"
          />
          <div class="units-note">
            <span><code>K</code> temperatura en kelvin: escala absoluta.</span>
            <span><code>rpm</code> revoluciones por minuto del husillo.</span>
            <span><code>N·m</code> newton-metro: momento de fuerza aplicado sobre el eje.</span>
            <span><code>min</code> minutos de uso acumulado de la herramienta.</span>
          </div>
        </div>

        <div class="panel-col">
          <form id="predict-form" class="card-container" novalidate>
            <article class="input-card">
              <div class="card-head">
                <span class="badge">1</span>
                <label for="air_temperature">
                  Temperatura del aire
                  <small>aire que rodea la máquina</small>
                </label>
              </div>
              <div class="card-body">
                <input id="air_temperature" name="air_temperature" type="number" step="0.1" inputmode="decimal" required value="298.5" />
                <span class="unit">K</span>
              </div>
              <span class="range">rango 290–310 K</span>
            </article>

            <article class="input-card">
              <div class="card-head">
                <span class="badge">2</span>
                <label for="process_temperature">
                  Temperatura del proceso
                  <small>motor del cabezal</small>
                </label>
              </div>
              <div class="card-body">
                <input id="process_temperature" name="process_temperature" type="number" step="0.1" inputmode="decimal" required value="308.5" />
                <span class="unit">K</span>
              </div>
              <span class="range">rango 300–320 K</span>
            </article>

            <article class="input-card">
              <div class="card-head">
                <span class="badge">3</span>
                <label for="rotational_speed">
                  Velocidad de rotación
                  <small>mandril del torno</small>
                </label>
              </div>
              <div class="card-body">
                <input id="rotational_speed" name="rotational_speed" type="number" step="1" inputmode="numeric" required value="1550" />
                <span class="unit">rpm</span>
              </div>
              <span class="range">rango 1100–3000 rpm</span>
            </article>

            <article class="input-card">
              <div class="card-head">
                <span class="badge">4</span>
                <label for="torque">
                  Torque
                  <small>husillo del torno</small>
                </label>
              </div>
              <div class="card-body">
                <input id="torque" name="torque" type="number" step="0.1" inputmode="decimal" required value="38" />
                <span class="unit">N·m</span>
              </div>
              <span class="range">rango 0–90 N·m</span>
            </article>

            <article class="input-card">
              <div class="card-head">
                <span class="badge">5</span>
                <label for="tool_wear">
                  Desgaste de herramienta
                  <small>cuchilla de corte</small>
                </label>
              </div>
              <div class="card-body">
                <input id="tool_wear" name="tool_wear" type="number" step="1" inputmode="numeric" required value="25" />
                <span class="unit">min</span>
              </div>
              <span class="range">rango 0–260 min</span>
            </article>
          </form>

          <div class="actions">
            <button class="primary" id="analyze-btn" type="submit" form="predict-form">Analizar condiciones</button>
          </div>
        </div>
      </div>
    </section>

    <div class="loading" id="loading">Procesando con el sistema difuso…</div>
    <div class="error" id="error" role="alert"></div>

    <section class="result" id="result" aria-label="Resultado">
      <h2>Resultado de la inspección</h2>

      <div class="risk-row">
        <div class="risk-score" id="risk-score">—<small> / 100</small></div>
        <div class="risk-level" id="risk-level">—</div>
      </div>

      <div class="bar">
        <div class="bar-fill" id="risk-bar"></div>
      </div>

      <div class="action" id="action-box">
        <strong id="action-title">—</strong>
        <span id="action-desc"></span>
      </div>

      <div class="factors">
        <strong>Factores detectados</strong>
        <ul id="factors-list"></ul>
      </div>

      <a class="toggle" href="/tecnico">Ver detalles de la inferencia en la vista técnica →</a>
    </section>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      const API_URL = 'http://localhost:8001/api/predict';

      const form = document.getElementById('predict-form') as HTMLFormElement;
      const loading = document.getElementById('loading') as HTMLElement;
      const errorBox = document.getElementById('error') as HTMLElement;
      const result = document.getElementById('result') as HTMLElement;
      const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;

      const LEVEL_COLORS: Record<string, string> = {
        bajo: '#51cf66',
        moderado: '#ffb54d',
        alto: '#ff922b',
        critico: '#ff6b6b',
      };

      const LEVEL_TEXT: Record<string, string> = {
        bajo: '#1a1a1a',
        moderado: '#1a1a1a',
        alto: '#1a1a1a',
        critico: '#1a1a1a',
      };

      const INPUT_IDS = ['air_temperature', 'process_temperature', 'rotational_speed', 'torque', 'tool_wear'];
      const INPUTS_KEY = 'mantenimiento_inputs';

      function restoreInputs(): void {
        try {
          const raw = sessionStorage.getItem(INPUTS_KEY);
          if (raw === null) return;
          const saved = JSON.parse(raw) as Record<string, string>;
          for (const id of INPUT_IDS) {
            const el = document.getElementById(id) as HTMLInputElement;
            if (el !== null && typeof saved[id] === 'string') {
              el.value = saved[id];
            }
          }
        } catch {
          /* datos corruptos o sin soporte: se ignoran */
        }
      }

      function saveInputs(): void {
        try {
          const values: Record<string, string> = {};
          for (const id of INPUT_IDS) {
            const el = document.getElementById(id) as HTMLInputElement;
            if (el !== null) {
              values[id] = el.value;
            }
          }
          sessionStorage.setItem(INPUTS_KEY, JSON.stringify(values));
        } catch {
          /* sin soporte de sessionStorage: se ignora */
        }
      }

      restoreInputs();
      for (const id of INPUT_IDS) {
        document.getElementById(id)?.addEventListener('input', saveInputs);
      }

      interface RuleActivation {
        name: string;
        cause: string;
        strength: number;
      }

      interface PredictResponse {
        risk_score: number;
        risk_level: string;
        risk_level_display: string;
        action: string;
        thermal_gap: number;
        factors: string[];
        activated_rules: RuleActivation[];
        memberships: Record<string, Record<string, number>>;
      }

      function showError(message: string): void {
        errorBox.style.display = 'block';
        errorBox.textContent = message;
      }

      function hideError(): void {
        errorBox.style.display = 'none';
      }

      function hideErrorAndShowLoading(): void {
        hideError();
        loading.style.display = 'block';
        result.style.display = 'none';
        analyzeBtn.disabled = true;
      }

      function renderResult(data: PredictResponse): void {
        const score = document.getElementById('risk-score') as HTMLElement;
        const level = document.getElementById('risk-level') as HTMLElement;
        const bar = document.getElementById('risk-bar') as HTMLElement;
        const actionTitle = document.getElementById('action-title') as HTMLElement;
        const actionDesc = document.getElementById('action-desc') as HTMLElement;
        const actionBox = document.getElementById('action-box') as HTMLElement;
        const factorsList = document.getElementById('factors-list') as HTMLElement;

        score.childNodes[0].textContent = String(data.risk_score);
        level.textContent = data.risk_level_display;
        const tone = LEVEL_COLORS[data.risk_level] ?? '#5c5c5c';
        level.style.background = tone;
        level.style.color = LEVEL_TEXT[data.risk_level] ?? '#efefef';
        level.style.padding = '3px 12px';
        level.style.borderRadius = '999px';
        bar.style.width = `${data.risk_score}%`;
        bar.style.background = tone;
        actionTitle.textContent = data.action;
        actionTitle.style.color = tone;
        actionBox.style.borderLeft = `3px solid ${tone}`;
        actionDesc.textContent = `Nivel ${data.risk_level_display.toLowerCase()} de riesgo de fallo predicho por el sistema difuso.`;

        factorsList.innerHTML = '';
        for (const factor of data.factors) {
          const item = document.createElement('li');
          item.textContent = factor;
          factorsList.appendChild(item);
        }

        result.style.display = 'block';
        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      form.addEventListener('submit', async (event: Event) => {
        event.preventDefault();
        hideErrorAndShowLoading();

        const values = {
          air_temperature: Number((document.getElementById('air_temperature') as HTMLInputElement).value),
          process_temperature: Number((document.getElementById('process_temperature') as HTMLInputElement).value),
          rotational_speed: Number((document.getElementById('rotational_speed') as HTMLInputElement).value),
          torque: Number((document.getElementById('torque') as HTMLInputElement).value),
          tool_wear: Number((document.getElementById('tool_wear') as HTMLInputElement).value),
        };

        try {
          const response = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(values),
          });

          if (!response.ok) {
            const body = await response.json().catch(() => null);
            const detail =
              body !== null && typeof body.detail === 'string' ? body.detail : `El servidor respondió ${response.status}.`;
            throw new Error(detail);
          }

          const data = (await response.json()) as PredictResponse;
          sessionStorage.setItem(
            'mantenimiento_prediccion',
            JSON.stringify({ values: values, response: data }),
          );
          renderResult(data);
        } catch (err) {
          showError(err instanceof Error ? err.message : 'Error inesperado.');
        } finally {
          loading.style.display = 'none';
          analyzeBtn.disabled = false;
        }
      });
    });
  </script>
</Base>