---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-mono/400.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  activeTab: "operacion" | "tecnica";
}

const { title, activeTab } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #1a1a1a;
        --panel: #222222;
        --panel-2: #282828;
        --border: #3a3a3a;
        --text: #e6e6e6;
        --muted: #9a9a9a;
        --accent: #c2c2c2;
        --accent-ink: #c2c2c2;
        --on-accent: #1e1e1e;
        --red: #d0654a;
        --radius: 12px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Geist Sans', system-ui, sans-serif;
        line-height: 1.5;
      }

      header {
        max-width: 1100px;
        margin: 0 auto;
        padding: 22px 20px 6px;
        text-align: center;
      }

      header h1 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 500;
        letter-spacing: 0.2px;
      }

      nav.tabs {
        max-width: 1100px;
        margin: 14px auto 0;
        padding: 0 20px;
        display: flex;
        gap: 8px;
      }

      nav.tabs a {
        font-size: 0.85rem;
        padding: 8px 14px;
        border-radius: 8px 8px 0 0;
        border: 1px solid var(--border);
        border-bottom: none;
        color: var(--muted);
        text-decoration: none;
      }

      nav.tabs a.active {
        background: var(--panel);
        color: var(--accent-ink);
        border-bottom: 2px solid var(--accent);
      }
    </style>
  </head>
  <body>
    <header transition:persist="header">
      <h1>Sistema inteligente de mantenimiento preventivo</h1>
    </header>

    <nav class="tabs" aria-label="Vistas">
      <a class:list={[{ active: activeTab === "operacion" }]} href="/">Vista de operación</a>
      <a class:list={[{ active: activeTab === "tecnica" }]} href="/tecnico">Vista técnica</a>
    </nav>

    <slot />
  </body>
</html>