---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="theme-color" content="#08080a" />
	<title>Focos · Control de Iluminación</title>
	<style is:global>
		:root {
			--surface: #000;
			--surface-raised: #0a0a0a;
			--surface-card: #111;
			--surface-hover: #181818;
			--edge: #222;
			--edge-subtle: #1a1a1a;
			--primary: #ededef;
			--secondary: #8a8a97;
			--muted: #6e6e78;
			--accent: #22c55e;
			--accent-dim: #16a34a;
			--warm: #ffd76a;
			--ease-out: cubic-bezier(.23, 1, .32, 1);
		}

		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		html {
			color-scheme: dark;
		}

		body {
			font-family: "Geist Sans", system-ui, ui-sans-serif, sans-serif;
			background: var(--surface);
			color: var(--primary);
			height: 100vh;
			overflow: hidden;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		::selection {
			background: color-mix(in srgb, var(--accent) 30%, transparent);
		}

		:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--accent) 75%, transparent);
			outline-offset: 2px;
		}

		.app {
			display: flex;
			height: 100vh;
			position: relative;
		}

		/* fondo: resplandor radial acento en la parte superior */
		.app::before {
			content: "";
			pointer-events: none;
			position: absolute;
			top: -3.5rem;
			left: -12%;
			right: -12%;
			height: 22rem;
			background: radial-gradient(
				ellipse at 50% 0%,
				color-mix(in srgb, var(--accent) 9%, transparent),
				transparent 70%
			);
			z-index: 0;
		}

		.app > * {
			position: relative;
			z-index: 1;
		}

		/* ---------- Sidebar / menu ---------- */
		.sidebar {
			width: 300px;
			flex-shrink: 0;
			background: var(--surface-raised);
			border-right: 1px solid var(--edge);
			display: flex;
			flex-direction: column;
			gap: 26px;
			padding: 22px 16px;
			overflow-y: auto;
		}

		.brand {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 0 6px;
		}

		.logo {
			width: 34px;
			height: 34px;
			border-radius: 8px;
			border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--edge));
			background: var(--surface-card);
			display: grid;
			place-items: center;
			color: var(--accent);
		}

		.logo svg {
			width: 20px;
			height: 20px;
		}

		.brand-text {
			display: flex;
			flex-direction: column;
			gap: 2px;
		}

		.brand-name {
			font-size: 14px;
			font-weight: 600;
			color: var(--primary);
			letter-spacing: -0.01em;
			line-height: 1.1;
		}

		.brand-sub {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--muted);
		}

		.section {
			padding: 0 6px;
		}

		.section-label {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--muted);
			margin-bottom: 10px;
		}

		.actions {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.btn {
			padding: 11px 12px;
			border: 1px solid var(--edge);
			border-radius: 8px;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 12px;
			font-weight: 500;
			cursor: pointer;
			transition: color .16s var(--ease-out), background-color .16s var(--ease-out),
				border-color .16s var(--ease-out), transform .1s var(--ease-out);
		}

		.btn:active {
			transform: scale(.97);
		}

		.btn-on {
			background: var(--surface-card);
			color: var(--accent);
			border-color: color-mix(in srgb, var(--accent) 40%, var(--edge));
		}

		.btn-on:hover {
			background: color-mix(in srgb, var(--accent) 12%, var(--surface-card));
			border-color: var(--accent);
		}

		.btn-off {
			background: var(--surface-card);
			color: var(--secondary);
		}

		.btn-off:hover {
			color: var(--primary);
			border-color: color-mix(in srgb, var(--primary) 30%, var(--edge));
		}

		.btn-opt {
			background: var(--surface-card);
			color: var(--warm);
			border-color: color-mix(in srgb, var(--warm) 40%, var(--edge));
		}

		.btn-opt:hover {
			background: color-mix(in srgb, var(--warm) 10%, var(--surface-card));
			border-color: var(--warm);
		}

		.btn-opt:disabled {
			opacity: 0.55;
			cursor: not-allowed;
			color: var(--muted);
			border-color: var(--edge);
			background: var(--surface-card);
		}

		/* ---------- Result metrics ---------- */
		.metrics {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.metric-empty {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--muted);
			padding: 12px;
			border: 1px dashed var(--edge);
			border-radius: 8px;
			text-align: center;
		}

		.metric {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 12px;
			padding: 9px 12px;
			background: var(--surface-card);
			border: 1px solid color-mix(in srgb, var(--edge) 60%, transparent);
			border-radius: 8px;
		}

		.metric-label {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--secondary);
		}

		.metric-value {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 13px;
			font-weight: 500;
			color: var(--warm);
			font-variant-numeric: tabular-nums;
			text-align: right;
		}

		.metric-focos {
			display: flex;
			gap: 5px;
			align-items: center;
		}

		.metric-foco {
			width: 12px;
			height: 12px;
			border-radius: 3px;
			background: var(--edge-subtle);
			border: 1px solid var(--edge);
		}

		.metric-foco.on {
			background: var(--warm);
			border-color: color-mix(in srgb, var(--warm) 70%, transparent);
			box-shadow: 0 0 6px color-mix(in srgb, var(--warm) 50%, transparent);
		}

		.room-dim {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			color: var(--muted);
		}

		/* ---------- Room view ---------- */
		.stage {
			flex: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 40px;
			position: relative;
		}

		.front-grid {
			display: none;
			flex-wrap: wrap;
			justify-content: center;
			align-items: center;
			gap: 20px;
			max-width: 800px;
		}

		.front-grid.active {
			display: flex;
		}

		.front-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 10px;
			padding: 14px;
			background: var(--surface-card);
			border: 1px solid var(--edge);
			border-radius: 10px;
			cursor: pointer;
			transition: border-color .16s var(--ease-out), transform .1s var(--ease-out);
		}

		.front-card:hover {
			border-color: color-mix(in srgb, var(--warm) 60%, var(--edge));
			transform: translateY(-2px);
		}

		.front-card.mini {
			position: relative;
			width: 160px;
			height: 140px;
			background: var(--surface-raised);
			border: 1px solid var(--edge);
			border-radius: 8px;
			overflow: hidden;
		}

		.front-card.mini .mini-foco {
			position: absolute;
			transform: translate(-50%, -50%);
			width: 14px;
			height: 14px;
			border-radius: 50%;
			background: var(--edge-subtle);
			border: 1px solid var(--edge);
		}

		.front-card.mini .mini-foco.on {
			background: var(--warm);
			border-color: color-mix(in srgb, var(--warm) 70%, transparent);
			box-shadow: 0 0 8px color-mix(in srgb, var(--warm) 60%, transparent);
		}

		.front-card .front-meta {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			color: var(--secondary);
			text-align: center;
		}

		.front-card.selected {
			border-color: var(--warm);
			box-shadow: 0 0 0 1px var(--warm);
		}

		.room-wrap {
			position: relative;
			width: 720px;
			height: 630px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.room {
			position: relative;
			width: 640px;
			height: 560px;
			background: var(--surface-raised);
			border: 1px solid var(--edge);
			border-radius: 12px;
			overflow: hidden;
			box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
		}

		.illum-layer {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 1;
		}

		.grid-layer {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 0;

			/* 8 columnas × 7 filas de 1 metro (80px) */
			background-image:
				linear-gradient(to right, rgba(142,142,152,0.10) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(142,142,152,0.10) 1px, transparent 1px);
			background-size: 80px 80px;
		}

		.grid-axis-label {
			position: absolute;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 9px;
			color: rgba(142,142,152,0.55);
			pointer-events: none;
			z-index: 1;
		}

		.dim {
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.86);
			transition: opacity .3s var(--ease-out);
			z-index: 2;
		}

		.foco-marker {
			position: absolute;
			transform: translate(-50%, -50%);
			pointer-events: auto;
			z-index: 3;
			cursor: pointer;
		}

		.foco-body {
			width: 20px;
			height: 20px;
			border-radius: 50%;
			background: var(--surface-hover);
			border: 1px solid var(--edge);
			position: relative;
			transition: background-color .16s var(--ease-out), border-color .16s var(--ease-out),
				box-shadow .16s var(--ease-out);
		}

		.foco.on .foco-body {
			background: var(--accent);
			border-color: color-mix(in srgb, var(--accent) 80%, #fff);
			box-shadow: 0 0 14px 3px color-mix(in srgb, var(--accent) 70%, transparent);
		}

		.foco-label {
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
			top: 26px;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			color: var(--muted);
			white-space: nowrap;
		}

		.foco-tooltip {
			position: absolute;
			left: 50%;
			top: -40px;
			transform: translateX(-50%);
			white-space: nowrap;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--primary);
			background: color-mix(in srgb, var(--surface-card) 95%, transparent);
			backdrop-filter: blur(12px);
			border: 1px solid var(--edge);
			border-radius: 6px;
			padding: 5px 8px;
			opacity: 0;
			pointer-events: none;
			transition: opacity .12s var(--ease-out);
			box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
		}

		.foco-marker:hover .foco-tooltip {
			opacity: 1;
		}

		.room-label {
			position: absolute;
			top: -30px;
			left: 0;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--muted);
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}

		.dimension {
			position: absolute;
			color: var(--muted);
			font-size: 12px;
			text-align: center;
			font-variant-numeric: tabular-nums;
		}

		.dim-w {
			bottom: -28px;
			left: 0;
			right: 0;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
		}

		.dim-h {
			left: -34px;
			top: 50%;
			transform: translateY(-50%) rotate(-90deg);
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
		}
	</style>
</head>
<body>
	<div class="app">
		<aside class="sidebar">
			<div class="brand">
				<div class="logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb-icon lucide-lightbulb"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
				</div>
				<div class="brand-text">
					<div class="brand-name">Focos</div>
					<div class="brand-sub">Sala 56 m²</div>
				</div>
			</div>

			<div class="section">
				<div class="section-label">Acciones</div>
				<div class="actions">
					<button class="btn btn-on" id="btn-all-on">Encender todos</button>
					<button class="btn btn-off" id="btn-all-off">Apagar todos</button>
				</div>
			</div>

			<div class="section">
				<div class="section-label">Optimización</div>
				<div class="actions">
					<button class="btn btn-opt" id="btn-local-search">Búsqueda local</button>
					<button class="btn btn-opt" id="btn-genetic">Algoritmo genético</button>
				</div>
			</div>

			<div class="section">
				<div class="section-label">Resultados</div>
				<div class="metrics" id="metrics">
					<div class="metric-empty">Presiona un algoritmo para optimizar</div>
				</div>
			</div>
		</aside>

		<main class="stage">
			<div class="front-grid" id="front-grid"></div>
			<div class="room-wrap" id="room-wrap">
				<div class="dimension dim-w">8 m</div>
				<div class="dimension dim-h">7 m</div>
				<div class="room" id="room">
					<div class="room-label">Vista cenital · cuadrícula 1 m</div>
					<div class="grid-layer" id="grid-layer"></div>
					<div class="dim" id="dim"></div>
					<div class="illum-layer" id="illum"></div>
				</div>
			</div>
		</main>
	</div>

	<script>
		// Coordenadas reales en metros (cuadrícula de 1m: ancho 0-8, alto 0-7)
		const FOCO_POSITIONS = [
			{ x: 2, y: 2 },
			{ x: 4, y: 2 },
			{ x: 6, y: 2 },
			{ x: 2, y: 5 },
			{ x: 4, y: 5 },
			{ x: 6, y: 5 },
		];

		const state = {
			radius: 2,
			focos: FOCO_POSITIONS.map((_, i) => ({ on: true })),
		};

		const room = document.getElementById("room");
		const illumLayer = document.getElementById("illum");
		const dimLayer = document.getElementById("dim");

		const WIDTH_M = 8;
		const HEIGHT_M = 7;
		const ROOM_W = 640;
		const ROOM_H = 560;
		const M_TO_PX = ROOM_W / WIDTH_M; // 80px por metro

		// Etiquetas de ejes (coordenadas en metros)
		const gridLayer = document.getElementById("grid-layer");
		for (let mx = 0; mx <= WIDTH_M; mx++) {
			const el = document.createElement("div");
			el.className = "grid-axis-label";
			el.textContent = String(mx);
			el.style.left = mx * M_TO_PX - 8 + "px";
			el.style.bottom = "2px";
			gridLayer?.appendChild(el);
		}
		for (let my = 0; my <= HEIGHT_M; my++) {
			const el = document.createElement("div");
			el.className = "grid-axis-label";
			el.textContent = String(my);
			el.style.left = "2px";
			el.style.top = my * M_TO_PX - 7 + "px";
			gridLayer?.appendChild(el);
		}

		const markers = [];
		FOCO_POSITIONS.forEach((pos, i) => {
			const marker = document.createElement("div");
			marker.className = "foco-marker";
			marker.style.left = pos.x * M_TO_PX + "px";
			marker.style.top = pos.y * M_TO_PX + "px";

			const body = document.createElement("div");
			body.className = "foco-body";

			const label = document.createElement("div");
			label.className = "foco-label";
			label.textContent = "F" + (i + 1);

			const tooltip = document.createElement("div");
			tooltip.className = "foco-tooltip";
			tooltip.textContent = "Foco " + (i + 1) + " · (" + pos.x + ", " + pos.y + ") m";

			marker.appendChild(body);
			marker.appendChild(label);
			marker.appendChild(tooltip);
			room?.appendChild(marker);

			marker.addEventListener("click", () => {
				state.focos[i].on = !state.focos[i].on;
				update();
			});

			markers.push(marker);
		});

		function update() {
			state.focos.forEach((f, i) => {
				markers[i].classList.toggle("on", f.on);
			});

			const anyOn = state.focos.some((f) => f.on);
			dimLayer.style.opacity = anyOn ? "0" : "1";

			const radiusPx = state.radius * M_TO_PX;
			let gradients = [];
			state.focos.forEach((f, i) => {
				if (!f.on) return;
				const x = FOCO_POSITIONS[i].x * M_TO_PX;
				const y = FOCO_POSITIONS[i].y * M_TO_PX;
				gradients.push(
					`radial-gradient(circle ${radiusPx}px at ${x}px ${y}px, rgba(255,215,106,0.40), rgba(255,215,106,0) 100%)`
				);
			});
			illumLayer.style.background = gradients.length
				? gradients.join(", ")
				: "transparent";
		}

		document.getElementById("btn-all-on").addEventListener("click", () => {
			showRoomView();
			state.focos.forEach((f) => (f.on = true));
			update();
		});

		document.getElementById("btn-all-off").addEventListener("click", () => {
			showRoomView();
			state.focos.forEach((f) => (f.on = false));
			update();
		});

		/* ---------- Optimización (backend) ---------- */

		const BACKEND_URL = "http://localhost:8000";
		const metricsPanel = document.getElementById("metrics");
		const btnLocalSearch = document.getElementById("btn-local-search");
		const btnGenetic = document.getElementById("btn-genetic");

		function renderMetrics(data, meta = {}) {
			const focos = data.focos;
			const potenciaW = data.potencia_w ?? meta.potencia_w ?? 15;
			const tiempoH = data.tiempo_h ?? meta.tiempo_h ?? 5;
			const energiaKwh = data.energia_kwh ?? meta.energia_kwh ?? null;
			const costoPorFoco = data.costo_por_foco ?? null;

			const rows = [
				{ label: "Focos", render: () => {
					const wrap = document.createElement("div");
					wrap.className = "metric-focos";
					focos.forEach((on, i) => {
						const dot = document.createElement("span");
						dot.className = "metric-foco" + (on ? " on" : "");
						wrap.appendChild(dot);
					});
					return wrap;
				}},
				{ label: "Focos encendidos", value: data.focos_encendidos + " / " + focos.length },
				{ label: "Iluminación", value: data.iluminacion.toFixed(4) },
				{ label: "Uniformidad", value: (data.uniformidad * 100).toFixed(1) + "%" },
				{ label: "Potencia", value: potenciaW + " W" },
				{ label: "Tiempo", value: tiempoH + " h" },
			];

			if (energiaKwh !== null) {
				rows.push({ label: "Energía", value: energiaKwh.toFixed(4) + " kWh" });
			}

			rows.push({ label: "Costo", value: "$ " + data.costo.toFixed(4) });

			if (costoPorFoco !== null) {
				rows.push({ label: "Costo por foco", value: "$ " + costoPorFoco.toFixed(4) });
			}

			metricsPanel.innerHTML = "";
			rows.forEach((r) => {
				const metric = document.createElement("div");
				metric.className = "metric";

				const label = document.createElement("span");
				label.className = "metric-label";
				label.textContent = r.label;

				const value = document.createElement("span");
				value.className = "metric-value";
				if (r.render) {
					value.appendChild(r.render());
				} else {
					value.textContent = r.value;
				}

				metric.appendChild(label);
				metric.appendChild(value);
				metricsPanel.appendChild(metric);
			});
		}

		function applySolution(data, meta = {}) {
			showRoomView();
			data.focos.forEach((on, i) => {
				state.focos[i].on = on === 1;
			});
			update();
			renderMetrics(data, meta);
		}

		const frontGrid = document.getElementById("front-grid");
		const roomWrap = document.getElementById("room-wrap");

		function showRoomView() {
			frontGrid.classList.remove("active");
			roomWrap.style.display = "";
		}

		function showFrontGrid() {
			frontGrid.classList.add("active");
			roomWrap.style.display = "none";
		}

		function buildThumbnail(sol, meta, isSelected) {
			const card = document.createElement("div");
			card.className = "front-card";

			const mini = document.createElement("div");
			mini.className = "front-card mini";

			FOCO_POSITIONS.forEach((pos, i) => {
				const dot = document.createElement("div");
				dot.className = "mini-foco" + (sol.focos[i] === 1 ? " on" : "");
				dot.style.left = (pos.x * 20) + "px";
				dot.style.top = (pos.y * 20) + "px";
				mini.appendChild(dot);
			});
			card.appendChild(mini);

			const metaDiv = document.createElement("div");
			metaDiv.className = "front-meta";
			metaDiv.innerHTML =
				sol.focos_encendidos + " focos · ilum " + sol.iluminacion.toFixed(3) +
				" · $ " + sol.costo.toFixed(3);
			card.appendChild(metaDiv);

			if (isSelected) card.classList.add("selected");

			card.addEventListener("click", () => {
				showRoomView();
				applySolution(sol, meta);
			});

			return card;
		}

		function renderFrontGrid(data) {
			frontGrid.innerHTML = "";
			const meta = {
				potencia_w: data.potencia_w,
				tiempo_h: data.tiempo_h,
			};
			data.frente.forEach((sol, i) => {
				frontGrid.appendChild(
					buildThumbnail(sol, meta, i === 0)
				);
			});
		}

		function showError(message) {
			metricsPanel.innerHTML = "";
			const empty = document.createElement("div");
			empty.className = "metric-empty";
			empty.textContent = message;
			metricsPanel.appendChild(empty);
		}

		function setLoading(button, loading) {
			button.disabled = loading;
		}

		btnLocalSearch.addEventListener("click", async () => {
			setLoading(btnLocalSearch, true);
			try {
				const res = await fetch(BACKEND_URL + "/api/local-search");
				if (!res.ok) throw new Error("Error en la petición");
				const data = await res.json();
				applySolution(data);
			} catch (e) {
				showError("No se pudo conectar con el backend");
			} finally {
				setLoading(btnLocalSearch, false);
			}
		});

		btnGenetic.addEventListener("click", async () => {
			setLoading(btnGenetic, true);
			try {
				const res = await fetch(BACKEND_URL + "/api/genetic");
				if (!res.ok) throw new Error("Error en la petición");
				const data = await res.json();
				showFrontGrid();
				renderFrontGrid(data);
				metricsPanel.innerHTML = "";
				const hint = document.createElement("div");
				hint.className = "metric-empty";
				hint.textContent = "Selecciona una solución del frente";
				metricsPanel.appendChild(hint);
			} catch (e) {
				showError("No se pudo conectar con el backend");
			} finally {
				setLoading(btnGenetic, false);
			}
		});

		update();
	</script>
</body>
</html>
