---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="theme-color" content="#08080a" />
	<title>Focos · Control de Iluminación</title>
	<style is:global>
		:root {
			--surface: #000;
			--surface-raised: #0a0a0a;
			--surface-card: #111;
			--surface-hover: #181818;
			--edge: #222;
			--edge-subtle: #1a1a1a;
			--primary: #ededef;
			--secondary: #8a8a97;
			--muted: #6e6e78;
			--accent: #22c55e;
			--accent-dim: #16a34a;
			--warm: #ffd76a;
			--ease-out: cubic-bezier(.23, 1, .32, 1);
		}

		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		html {
			color-scheme: dark;
		}

		body {
			font-family: "Geist Sans", system-ui, ui-sans-serif, sans-serif;
			background: var(--surface);
			color: var(--primary);
			height: 100vh;
			overflow: hidden;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		::selection {
			background: color-mix(in srgb, var(--accent) 30%, transparent);
		}

		:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--accent) 75%, transparent);
			outline-offset: 2px;
		}

		.app {
			display: flex;
			height: 100vh;
			position: relative;
		}

		/* fondo: resplandor radial acento en la parte superior */
		.app::before {
			content: "";
			pointer-events: none;
			position: absolute;
			top: -3.5rem;
			left: -12%;
			right: -12%;
			height: 22rem;
			background: radial-gradient(
				ellipse at 50% 0%,
				color-mix(in srgb, var(--accent) 9%, transparent),
				transparent 70%
			);
			z-index: 0;
		}

		.app > * {
			position: relative;
			z-index: 1;
		}

		/* ---------- Sidebar / menu ---------- */
		.sidebar {
			width: 300px;
			flex-shrink: 0;
			background: var(--surface-raised);
			border-right: 1px solid var(--edge);
			display: flex;
			flex-direction: column;
			gap: 26px;
			padding: 22px 16px;
			overflow-y: auto;
		}

		.brand {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 0 6px;
		}

		.logo {
			width: 34px;
			height: 34px;
			border-radius: 8px;
			border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--edge));
			background: var(--surface-card);
			display: grid;
			place-items: center;
			color: var(--accent);
		}

		.logo svg {
			width: 20px;
			height: 20px;
		}

		.brand-text {
			display: flex;
			flex-direction: column;
			gap: 2px;
		}

		.brand-name {
			font-size: 14px;
			font-weight: 600;
			color: var(--primary);
			letter-spacing: -0.01em;
			line-height: 1.1;
		}

		.brand-sub {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--muted);
		}

		.section {
			padding: 0 6px;
		}

		.section-label {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--muted);
			margin-bottom: 10px;
		}

		.foco-list {
			display: flex;
			flex-direction: column;
			gap: 6px;
		}

		.foco-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 10px 12px;
			background: var(--surface-card);
			border: 1px solid color-mix(in srgb, var(--edge) 60%, transparent);
			border-radius: 8px;
			cursor: pointer;
			transition: background-color .16s var(--ease-out), border-color .16s var(--ease-out);
		}

		.foco-row:hover {
			background: var(--surface-hover);
		}

		.foco-row.on {
			border-color: color-mix(in srgb, var(--accent) 28%, var(--edge));
		}

		.foco-name {
			display: flex;
			align-items: center;
			gap: 10px;
			font-size: 14px;
			font-weight: 500;
			color: var(--primary);
		}

		.foco-name .id {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			color: var(--muted);
			background: var(--surface-raised);
			border: 1px solid var(--edge);
			border-radius: 4px;
			padding: 2px 5px;
		}

		.foco-dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: var(--edge-subtle);
			transition: background .16s var(--ease-out), box-shadow .16s var(--ease-out);
		}

		.foco-row.on .foco-dot {
			background: var(--accent);
			box-shadow: 0 0 8px 1px color-mix(in srgb, var(--accent) 60%, transparent);
		}

		.foco-status {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--muted);
		}

		.foco-row.on .foco-status {
			color: var(--accent);
		}

		/* switch */
		.switch {
			position: relative;
			width: 40px;
			height: 22px;
			flex-shrink: 0;
		}

		.switch input {
			opacity: 0;
			width: 0;
			height: 0;
			position: absolute;
		}

		.slider {
			position: absolute;
			inset: 0;
			background: var(--edge-subtle);
			border: 1px solid var(--edge);
			border-radius: 999px;
			cursor: pointer;
			transition: background-color .16s var(--ease-out), border-color .16s var(--ease-out);
		}

		.slider::before {
			content: "";
			position: absolute;
			width: 16px;
			height: 16px;
			left: 2px;
			top: 2px;
			background: var(--muted);
			border-radius: 50%;
			transition: transform .16s var(--ease-out), background-color .16s var(--ease-out);
		}

		.switch input:checked + .slider {
			background: color-mix(in srgb, var(--accent) 22%, var(--surface-card));
			border-color: color-mix(in srgb, var(--accent) 45%, var(--edge));
		}

		.switch input:checked + .slider::before {
			transform: translateX(18px);
			background: var(--accent);
		}

		.actions {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.btn {
			padding: 11px 12px;
			border: 1px solid var(--edge);
			border-radius: 8px;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 12px;
			font-weight: 500;
			cursor: pointer;
			transition: color .16s var(--ease-out), background-color .16s var(--ease-out),
				border-color .16s var(--ease-out), transform .1s var(--ease-out);
		}

		.btn:active {
			transform: scale(.97);
		}

		.btn-on {
			background: var(--surface-card);
			color: var(--accent);
			border-color: color-mix(in srgb, var(--accent) 40%, var(--edge));
		}

		.btn-on:hover {
			background: color-mix(in srgb, var(--accent) 12%, var(--surface-card));
			border-color: var(--accent);
		}

		.btn-off {
			background: var(--surface-card);
			color: var(--secondary);
		}

		.btn-off:hover {
			color: var(--primary);
			border-color: color-mix(in srgb, var(--primary) 30%, var(--edge));
		}

		.radius-group {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}

		.radius-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-size: 12px;
			color: var(--secondary);
		}

		.mono-label {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--muted);
		}

		.radius-value {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 13px;
			font-weight: 500;
			color: var(--primary);
			font-variant-numeric: tabular-nums;
		}

		input[type="range"] {
			-webkit-appearance: none;
			appearance: none;
			width: 100%;
			height: 3px;
			border-radius: 999px;
			background: var(--edge-subtle);
			outline: none;
			cursor: pointer;
		}

		input[type="range"]::-webkit-slider-thumb {
			-webkit-appearance: none;
			appearance: none;
			width: 14px;
			height: 14px;
			border-radius: 50%;
			background: var(--accent);
			border: 2px solid var(--surface-card);
			cursor: pointer;
			box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 50%, transparent);
			transition: transform .16s var(--ease-out);
		}

		input[type="range"]::-webkit-slider-thumb:hover {
			transform: scale(1.1);
		}

		input[type="range"]::-moz-range-thumb {
			width: 14px;
			height: 14px;
			border-radius: 50%;
			background: var(--accent);
			border: 2px solid var(--surface-card);
			cursor: pointer;
		}

		.room-dim {
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			color: var(--muted);
		}

		/* ---------- Room view ---------- */
		.stage {
			flex: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 40px;
			position: relative;
		}

		.room-wrap {
			position: relative;
			width: 720px;
			height: 630px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.room {
			position: relative;
			width: 640px;
			height: 560px;
			background: var(--surface-raised);
			border: 1px solid var(--edge);
			border-radius: 12px;
			overflow: hidden;
			box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
		}

		.illum-layer {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 1;
		}

		.grid-layer {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 0;

			/* 8 columnas × 7 filas de 1 metro (80px) */
			background-image:
				linear-gradient(to right, rgba(142,142,152,0.10) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(142,142,152,0.10) 1px, transparent 1px);
			background-size: 80px 80px;
		}

		.grid-axis-label {
			position: absolute;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 9px;
			color: rgba(142,142,152,0.55);
			pointer-events: none;
			z-index: 1;
		}

		.dim {
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.86);
			transition: opacity .3s var(--ease-out);
			z-index: 2;
		}

		.foco-marker {
			position: absolute;
			transform: translate(-50%, -50%);
			pointer-events: auto;
			z-index: 3;
			cursor: pointer;
		}

		.foco-body {
			width: 20px;
			height: 20px;
			border-radius: 50%;
			background: var(--surface-hover);
			border: 1px solid var(--edge);
			position: relative;
			transition: background-color .16s var(--ease-out), border-color .16s var(--ease-out),
				box-shadow .16s var(--ease-out);
		}

		.foco.on .foco-body {
			background: var(--accent);
			border-color: color-mix(in srgb, var(--accent) 80%, #fff);
			box-shadow: 0 0 14px 3px color-mix(in srgb, var(--accent) 70%, transparent);
		}

		.foco-label {
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
			top: 26px;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 10px;
			color: var(--muted);
			white-space: nowrap;
		}

		.foco-tooltip {
			position: absolute;
			left: 50%;
			top: -40px;
			transform: translateX(-50%);
			white-space: nowrap;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--primary);
			background: color-mix(in srgb, var(--surface-card) 95%, transparent);
			backdrop-filter: blur(12px);
			border: 1px solid var(--edge);
			border-radius: 6px;
			padding: 5px 8px;
			opacity: 0;
			pointer-events: none;
			transition: opacity .12s var(--ease-out);
			box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
		}

		.foco-marker:hover .foco-tooltip {
			opacity: 1;
		}

		.room-label {
			position: absolute;
			top: -30px;
			left: 0;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
			color: var(--muted);
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}

		.dimension {
			position: absolute;
			color: var(--muted);
			font-size: 12px;
			text-align: center;
			font-variant-numeric: tabular-nums;
		}

		.dim-w {
			bottom: -28px;
			left: 0;
			right: 0;
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
		}

		.dim-h {
			left: -34px;
			top: 50%;
			transform: translateY(-50%) rotate(-90deg);
			font-family: "Geist Mono", ui-monospace, monospace;
			font-size: 11px;
		}
	</style>
</head>
<body>
	<div class="app">
		<aside class="sidebar">
			<div class="brand">
				<div class="logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb-icon lucide-lightbulb"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
				</div>
				<div class="brand-text">
					<div class="brand-name">Focos</div>
					<div class="brand-sub">Sala 56 m²</div>
				</div>
			</div>

			<div class="section">
				<div class="section-label">Focos</div>
				<div class="foco-list" id="foco-list"></div>
			</div>

			<div class="section">
				<div class="section-label">Acciones</div>
				<div class="actions">
					<button class="btn btn-on" id="btn-all-on">Encender todos</button>
					<button class="btn btn-off" id="btn-all-off">Apagar todos</button>
				</div>
			</div>

			<div class="section">
				<div class="section-label">Parámetros</div>
				<div class="radius-group">
					<div class="radius-row">
						<span class="mono-label">Radio efectivo</span>
						<span class="radius-value" id="radius-value">2 m</span>
					</div>
					<input type="range" id="radius" min="0.5" max="4" step="0.1" value="2" />
				</div>
			</div>
		</aside>

		<main class="stage">
			<div class="room-wrap">
				<div class="dimension dim-w">8 m</div>
				<div class="dimension dim-h">7 m</div>
				<div class="room" id="room">
					<div class="room-label">Vista cenital · cuadrícula 1 m</div>
					<div class="grid-layer" id="grid-layer"></div>
					<div class="dim" id="dim"></div>
					<div class="illum-layer" id="illum"></div>
				</div>
			</div>
		</main>
	</div>

	<script>
		// Coordenadas reales en metros (cuadrícula de 1m: ancho 0-8, alto 0-7)
		const FOCO_POSITIONS = [
			{ x: 2, y: 2 },
			{ x: 4, y: 2 },
			{ x: 6, y: 2 },
			{ x: 2, y: 5 },
			{ x: 4, y: 5 },
			{ x: 6, y: 5 },
		];

		const state = {
			radius: 2,
			focos: FOCO_POSITIONS.map((_, i) => ({ on: true })),
		};

		const room = document.getElementById("room");
		const illumLayer = document.getElementById("illum");
		const dimLayer = document.getElementById("dim");
		const focoList = document.getElementById("foco-list");

		const WIDTH_M = 8;
		const HEIGHT_M = 7;
		const ROOM_W = 640;
		const ROOM_H = 560;
		const M_TO_PX = ROOM_W / WIDTH_M; // 80px por metro

		// Etiquetas de ejes (coordenadas en metros)
		const gridLayer = document.getElementById("grid-layer");
		for (let mx = 0; mx <= WIDTH_M; mx++) {
			const el = document.createElement("div");
			el.className = "grid-axis-label";
			el.textContent = String(mx);
			el.style.left = mx * M_TO_PX - 8 + "px";
			el.style.bottom = "2px";
			gridLayer?.appendChild(el);
		}
		for (let my = 0; my <= HEIGHT_M; my++) {
			const el = document.createElement("div");
			el.className = "grid-axis-label";
			el.textContent = String(my);
			el.style.left = "2px";
			el.style.top = my * M_TO_PX - 7 + "px";
			gridLayer?.appendChild(el);
		}

		const markers = [];
		FOCO_POSITIONS.forEach((pos, i) => {
			const marker = document.createElement("div");
			marker.className = "foco-marker";
			marker.style.left = pos.x * M_TO_PX + "px";
			marker.style.top = pos.y * M_TO_PX + "px";

			const body = document.createElement("div");
			body.className = "foco-body";

			const label = document.createElement("div");
			label.className = "foco-label";
			label.textContent = "F" + (i + 1);

			const tooltip = document.createElement("div");
			tooltip.className = "foco-tooltip";
			tooltip.textContent = "Foco " + (i + 1) + " · (" + pos.x + ", " + pos.y + ") m";

			marker.appendChild(body);
			marker.appendChild(label);
			marker.appendChild(tooltip);
			room?.appendChild(marker);

			marker.addEventListener("click", () => {
				state.focos[i].on = !state.focos[i].on;
				update();
			});

			markers.push(marker);
		});

		function buildMenu() {
			focoList.innerHTML = "";
			state.focos.forEach((f, i) => {
				const row = document.createElement("label");
				row.className = "foco-row";

				const name = document.createElement("div");
				name.className = "foco-name";
				const id = document.createElement("span");
				id.className = "id";
				id.textContent = "0" + (i + 1);
				const text = document.createElement("span");
				text.textContent = "Foco " + (i + 1);
				name.appendChild(id);
				name.appendChild(text);

				const status = document.createElement("span");
				status.className = "foco-status";
				status.textContent = "Apagado";

				const sw = document.createElement("div");
				sw.className = "switch";
				const input = document.createElement("input");
				input.type = "checkbox";
				const slider = document.createElement("span");
				slider.className = "slider";
				sw.appendChild(input);
				sw.appendChild(slider);

				input.addEventListener("change", () => {
					f.on = input.checked;
					update();
				});

				row.appendChild(name);
				row.appendChild(status);
				row.appendChild(sw);
				focoList.appendChild(row);
			});
		}

		function update() {
			const rows = focoList.querySelectorAll(".foco-row");
			state.focos.forEach((f, i) => {
				rows[i].classList.toggle("on", f.on);
				const cb = rows[i].querySelector("input");
				if (cb.checked !== f.on) cb.checked = f.on;
				const st = rows[i].querySelector(".foco-status");
				st.textContent = f.on ? "Encendido" : "Apagado";
				markers[i].classList.toggle("on", f.on);
			});

			const anyOn = state.focos.some((f) => f.on);
			dimLayer.style.opacity = anyOn ? "0" : "1";

			const radiusPx = state.radius * M_TO_PX;
			let gradients = [];
			state.focos.forEach((f, i) => {
				if (!f.on) return;
				const x = FOCO_POSITIONS[i].x * M_TO_PX;
				const y = FOCO_POSITIONS[i].y * M_TO_PX;
				gradients.push(
					`radial-gradient(circle ${radiusPx}px at ${x}px ${y}px, rgba(255,215,106,0.40), rgba(255,215,106,0) 100%)`
				);
			});
			illumLayer.style.background = gradients.length
				? gradients.join(", ")
				: "transparent";
		}

		const radiusInput = document.getElementById("radius");
		const radiusValue = document.getElementById("radius-value");
		radiusInput.addEventListener("input", () => {
			state.radius = parseFloat(radiusInput.value);
			radiusValue.textContent = state.radius.toFixed(1) + " m";
			update();
		});

		document.getElementById("btn-all-on").addEventListener("click", () => {
			state.focos.forEach((f) => (f.on = true));
			update();
		});

		document.getElementById("btn-all-off").addEventListener("click", () => {
			state.focos.forEach((f) => (f.on = false));
			update();
		});

		buildMenu();
		update();
	</script>
</body>
</html>
